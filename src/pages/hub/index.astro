---
// popular games

import TheatreSearchBar from "@components/TheatreSearchBar.astro";
import themeStyles from "@styles/ThemeElements.module.scss";
import { gameCategories, type Category } from "@lib/gameCategories";
import styles from "@styles/TheatreCategory.module.scss";
import ArrowForward from "@icons/arrow_forward_24dp.svg?react";
import MainLayout from "@layouts/MainLayout.astro";
import { createHUServerClient } from "@lib/hu";
import { readHULaunchId } from "@lib/proxyRoutes.js";
import type { ListData, TheatreEntryMin } from "@lib/TheatreAPI";
import TheatreItem from "@components/TheatreItem.astro";
import TheatreCategory from "@components/TheatreCategory.astro";
import ThemeSelect from "@components/ThemeSelect.astro";
import Banner from "@components/Banner.astro";
import TheatrePlayer from "@components/TheatrePlayer.astro";

const entryLimit = 15;
const hu = createHUServerClient({
  endpoint: new URL("/v1/games/", Astro.locals.origin).toString(),
  publicBase: "/cdn/",
  cookie: Astro.request.headers.get("cookie"),
  seed: Astro.locals.proxyRoutes.seed,
});

const sortOptions = [
  { name: "Most Popular", value: "mostPopular" },
  { name: "Least Popular", value: "leastPopular" },
  { name: "Name (A-Z)", value: "nameASC" },
  { name: "Name (Z-A)", value: "nameDESC" },
];

let error: string | undefined;
let data: ListData | undefined;
const v = Astro.url.searchParams.get("v");
const launchId = v === null ? null : readHULaunchId(Astro.locals.proxyRoutes, v);
const invalidLaunch = v !== null && !launchId;

const q = Astro.url.searchParams.get("q");

const sortParam = Astro.url.searchParams.get("sort");
const sort =
  typeof sortParam === "string" &&
  sortOptions.some((e) => e.value === sortParam)
    ? sortParam
    : "mostPopular";

let apiSort: string | undefined;
let apiOrder: string | undefined;
switch (sort) {
  case "leastPopular":
    apiSort = "plays";
    apiOrder = "asc";
    break;
  case "mostPopular":
    apiSort = "plays";
    break;
  case "nameASC":
    apiSort = "name";
    apiOrder = "asc";
    break;
  case "nameDESC":
    apiSort = "name";
    apiOrder = "desc";
    break;
}

if (v === null)
  try {
    data = await hu.query({
      sort: apiSort,
      order: apiOrder,
      groupBy: q === null ? "category" : undefined,
      limitPerGroup: q === null ? entryLimit : undefined,
      q: q ?? undefined,
    });
  } catch (err) {
    error =
      "We were unable to process your request. Please try again later, or [Contact Us](/contact) if this continues to happen";
    Astro.response.headers.set("reload", "5");
    Astro.response.status = 502;
    console.error(err);
  }

const renderCategories: { category: Category; entries: TheatreEntryMin[] }[] =
  [];

if (data !== undefined) {
  if (q !== null) {
    if (data.entries.length === 0) {
      Astro.response.status = 404;
    }
  }

  if (Array.isArray(data.groups)) {
    for (const group of data.groups) {
      const category = gameCategories.find((entry) => entry.id === group.key);
      if (!category) continue;
      renderCategories.push({
        category,
        entries: group.games,
      });
    }
  } else {
    for (const category of gameCategories) {
      const entries = data.entries.filter((e) =>
        e.category.includes(category.id)
      );

      if (entries.length !== 0)
        renderCategories.push({
          category,
          entries,
        });
    }
  }
}
---

{
  v === null ? (
    <MainLayout title="Popular Games">
      {Astro.locals.isMainWebsite && (
        <Fragment slot="head">
          <meta
            name="description"
            content={
              q === null
                ? "Popular games on Holy Unblocker."
                : `Find ${q} games on Holy Unblocker`
            }
          />
        </Fragment>
      )}
      {q === null ? (
        <>
          <TheatreSearchBar />
          <main class={styles.main}>
            <Banner error={error} />
            <div class={styles.name} style="justify-content: flex-end">
              <ThemeSelect options={sortOptions} id="sort" value={sort} />
            </div>
            {renderCategories.map(({ category, entries }) => (
              <section class={styles.expand}>
                <div class={styles.name}>
                  <h1>{category.name}</h1>
                  <a
                    class={themeStyles.themeLink}
                    href={`/hub/${category.id}`}
                    class={styles.seeAll}
                  >
                    See All
                    <Fragment set:html={ArrowForward} />
                  </a>
                </div>
                <div class:list={[styles.items, styles.flex]}>
                  {entries.map((e) => (
                    <TheatreItem name={e.name} id={e.id} imagePath={e.imagePath} launchPath={e.launchPath} />
                  ))}
                </div>
              </section>
            ))}
          </main>
        </>
      ) : (
        <TheatreCategory
          name={`Search results for '${q}'`}
          search={q}
          placeholder="Search by game name"
        />
      )}
    </MainLayout>
  ) : invalidLaunch ? (
    <MainLayout title="Invalid game">
      <main>
        <p>Invalid game ID</p>
      </main>
    </MainLayout>
  ) : (
    <TheatrePlayer id={launchId!} />
  )
}

<script>
  document.addEventListener("astro:page-load", () => {
    const sortInput = document.querySelector<HTMLInputElement>("#sort");
    if (sortInput === null) return;

    sortInput.addEventListener("change", () => {
      const params = new URLSearchParams(location.search);
      if (sortInput.value === "mostPopular") params.delete("sort");
      else params.set("sort", sortInput.value);
      const st = params.toString();
      location.href = st === "" ? location.pathname : `${location.pathname}?${st}`;
    });
  });
</script>
