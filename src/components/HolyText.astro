---
type Props = astroHTML.JSX.IntrinsicElements["div"] & {
  text: string;
};
import { makeDashPlaceholder } from "@sysce/estrogen/cloak";

const { text, ...props } = Astro.props;
---

{
  Astro.locals.isMainWebsite ? (
    <span {...props} set:text={text} />
  ) : (
    <span
      {...props}
      data-ectext={await Astro.locals.encryptText(text)}
      set:text={makeDashPlaceholder(text)}
    />
  )
}
<script>
  import { setupSpanCloak } from "@sysce/estrogen/cloak/span";

  setupSpanCloak();
</script>
